# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Anthropic (content + comment drafting) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- LinkedIn OAuth app (https://www.linkedin.com/developers/apps) ---
# Create an app, add the "Share on LinkedIn" and "Sign In with OpenID Connect"
# products, then copy the client id/secret here.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must match a redirect URL registered on the app exactly.
LINKEDIN_REDIRECT_URI=http://localhost:8765/callback

# --- Optional overrides ---
# AUTOPILOT_CONFIG=./config.yaml
# AUTOPILOT_STATE_DIR=./state
